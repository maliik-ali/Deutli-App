# Copy to .env.local for local development. Never commit real values.
# Find these in Supabase: Project Settings -> API Keys / Data API.

# Your project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The "publishable" key (starts with sb_publishable_) — or the legacy "anon" key.
# Safe to use with Row Level Security, but we still only read it on the server.
SUPABASE_PUBLISHABLE_KEY=

# The address of the deployed site, used in email links (no trailing slash).
# Locally: http://localhost:3000   On Vercel: https://your-app.vercel.app
SITE_URL=http://localhost:3000

# Server-only secret key (Supabase: Project Settings -> API Keys -> "secret", starts with sb_secret_).
# Used only to write the shared word dictionary and count daily translations. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Anthropic API key for automatic word translation (Daily Practice "Save word").
# Server-only. NEVER prefix with NEXT_PUBLIC_. Without it, students type meanings themselves.
ANTHROPIC_API_KEY=

# AI model for writing feedback. Server-only. Default (nothing set): Anthropic Claude Haiku using ANTHROPIC_API_KEY above.
# To use another service (Gemini, Groq, OpenRouter, DeepSeek, Kimi … any OpenAI-compatible one):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=<model name>
#   AI_API_KEY=<key>
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Free German grammar checker (LanguageTool). Empty = the free public server (limits apply). Set to your own server later.
LANGUAGETOOL_URL=

# Card payments with Stripe (server-only, NEVER prefix with NEXT_PUBLIC_). Empty = the card option shows "Soon".
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://app.deutli.com/api/stripe/webhook (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Currency of the card charge. Default pkr. Your Stripe account must support it.
STRIPE_CURRENCY=


# Emails from the app with Resend (server-only). Empty = no emails are sent and everything else keeps working.
RESEND_API_KEY=
# Sender shown to students. The domain must be verified in Resend. Default: Deutli <help@deutli.com>
EMAIL_FROM=
