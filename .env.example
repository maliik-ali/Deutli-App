# Copy to .env.local for local development. Never commit real values.
# Find these in Supabase: Project Settings -> API Keys / Data API.

# Your project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The "publishable" key (starts with sb_publishable_) — or the legacy "anon" key.
# Safe to use with Row Level Security, but we still only read it on the server.
SUPABASE_PUBLISHABLE_KEY=

# The address of the deployed site, used in email links (no trailing slash).
# Locally: http://localhost:3000   On Vercel: https://your-app.vercel.app
SITE_URL=http://localhost:3000

# Not used yet. Server-only admin key. NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Anthropic API key for automatic word translation (Daily Practice "Save word").
# Server-only. NEVER prefix with NEXT_PUBLIC_. Without it, students type meanings themselves.
ANTHROPIC_API_KEY=
